# --- Printer -------------------------------------------------------------
# IP of the PT-P750W in your WLAN (give it a fixed DHCP lease in the router).
PTB_PRINTER_HOST=192.168.1.50
PTB_PRINTER_PORT=9100

# --- API -----------------------------------------------------------------
# Shared secret for the API (Authorization: Bearer <token>).
# Leave empty to have one generated into ./data/token on first start.
# Generate:  openssl rand -base64 32
PTB_TOKEN=

# --- Defaults (each can be overridden per job) ---------------------------
# Tape assumed when the printer does not report its status over the network.
PTB_DEFAULT_TAPE_MM=24
# Feed margin before/after each label, mm.
PTB_MARGIN_MM=2
# each = cut every label, half = half cut between labels, none = no cut between labels
PTB_CUT=each
# 1 = chain printing (no feed/cut after the last label, saves tape on the next job)
PTB_CHAIN=0
PTB_MAX_COPIES=50
# Command set: standard (auto/half cut, chain, margin) or minimal (auto cut only,
# exactly what ptouch-print sends) – try minimal if the printer goes to ERROR.
PTB_PROFILE=standard

# --- Status read-back -------------------------------------------------------
# Over Wi-Fi the PT-P750W often ignores the status request on port 9100; the
# bridge then reads the same status via SNMP (UDP 161). Empty = SNMP off.
PTB_SNMP_COMMUNITY=public

# --- Timeouts (seconds) ----------------------------------------------------
PTB_CONNECT_TIMEOUT=5
PTB_STATUS_TIMEOUT=2
PTB_WAIT_TIMEOUT=25

# --- Misc ----------------------------------------------------------------
PTB_MAX_UPLOAD_MB=15
# Jobs kept in the history (with raster preview). 0 = none.
PTB_HISTORY=50
PTB_LOG_LEVEL=INFO

# Docker: host port for the web UI / API
PTB_PUBLISH=8750
# User the bridge runs as inside the container; ./data is handed to it on start.
PUID=1000
PGID=1000

# Only for "docker compose --profile tunnel up -d" (own tunnel for the bridge)
CLOUDFLARE_TUNNEL_TOKEN=
